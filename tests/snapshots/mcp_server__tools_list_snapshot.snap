---
source: tests/mcp_server.rs
expression: "replies[0][\"result\"]"
---
{
  "tools": [
    {
      "name": "note_save",
      "description": "Call before you finish: save what you learned for later sessions, after finishing work, fixing a non-obvious problem, finding where something lives, or an optimisation. Save only what a later agent or teammate cannot get from the code or git history (a root cause and fix, a decision and why, a gotcha); never routine setup, installs or progress. Use repo-relative paths. A note with the same title in the scope is updated (a repository note written from another checkout, or reached through project_path, is reported instead: replace it with note_update). Similar notes are listed so you can update or delete outdated ones (those marked team, read-only cannot be changed from here). Add 3-5 tags: synonyms and other words a later search might use. Never store secrets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Short, specific title (1-120 characters)"
          },
          "body": {
            "type": "string",
            "description": "The knowledge itself, concise (1-4000 characters)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "outcome",
              "problem",
              "fix",
              "optimisation",
              "location",
              "decision",
              "note"
            ],
            "description": "Note kind"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$",
              "maxLength": 32
            },
            "maxItems": 8,
            "description": "Lowercase tags: 3-5 synonyms and other words a later search might use"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 10,
            "description": "Files, modules, components or concepts the note is about"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global"
            ],
            "default": "repo",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "title",
          "body",
          "kind",
          "project_path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "note_update",
      "description": "Correct or extend a note by id. Give only the fields to change; append adds text to the body. A team note of a scope set to remote+local is read-only (refused): save a new note instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Note id"
          },
          "title": {
            "type": "string",
            "description": "New title (1-120 characters)"
          },
          "body": {
            "type": "string",
            "description": "New body (1-4000 characters)"
          },
          "append": {
            "type": "string",
            "description": "Text added to the end of the body"
          },
          "kind": {
            "type": "string",
            "enum": [
              "outcome",
              "problem",
              "fix",
              "optimisation",
              "location",
              "decision",
              "note"
            ],
            "description": "Note kind"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$",
              "maxLength": 32
            },
            "maxItems": 8,
            "description": "Lowercase tags: 3-5 synonyms and other words a later search might use"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "both"
            ],
            "default": "both",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "note_search",
      "description": "Call FIRST at the start of every task: returns known fixes, decisions and file locations for this repository. Find notes by a few keywords; repository notes are listed before global ones, and without a query the most recent notes are listed. A message that starts with a `<harness-memory-recall>` block already carries the notes found for that message: search further only if needed. Saved scripts whose name or description match the keywords are listed after the notes: prefer script_run to retyping them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A few keywords (at most 256 characters)"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "both"
            ],
            "default": "both",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "kind": {
            "type": "string",
            "enum": [
              "outcome",
              "problem",
              "fix",
              "optimisation",
              "location",
              "decision",
              "note"
            ],
            "description": "Note kind"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Rows (default 8)"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          },
          "same_checkout": {
            "type": "boolean",
            "default": false,
            "description": "Only repository notes last written from the current checkout, not through project_path"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "note_get",
      "description": "Read whole notes by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "maxItems": 5,
            "description": "Note ids"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "both"
            ],
            "default": "both",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "note_delete",
      "description": "Delete an outdated or wrong note by id, looked up in this repository and the global scope unless scope is given. A team note of a scope set to remote+local is read-only (refused).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Note id"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "both"
            ],
            "default": "both",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "entity_link",
      "description": "Relate two entities: `from relation to`, for example `GitCli located_in business/src/git/cli.rs` or `retry-fix resolves flaky-test`. Missing entities are created. note_id cannot be a read-only team note (scope set to remote+local).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Entity name (at most 80 characters)"
          },
          "relation": {
            "type": "string",
            "description": "Relation such as located_in, resolves, depends_on (at most 40 characters)"
          },
          "to": {
            "type": "string",
            "description": "Entity name (at most 80 characters)"
          },
          "note_id": {
            "type": "integer",
            "description": "A note explaining the relation"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global"
            ],
            "default": "repo",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "from",
          "relation",
          "to",
          "project_path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "entity_neighbors",
      "description": "Show the relations around an entity and the notes linked to them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "description": "Entity name"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2,
            "description": "Hops (default 1)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Relations (default 20)"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "both"
            ],
            "default": "both",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "entity"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "entity_delete",
      "description": "Delete an entity with its relations (entity), or one relation (from, relation, to). Give exactly one of these forms.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "description": "Entity name"
          },
          "from": {
            "type": "string",
            "description": "Relation source entity"
          },
          "relation": {
            "type": "string",
            "description": "Relation"
          },
          "to": {
            "type": "string",
            "description": "Relation target entity"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global"
            ],
            "default": "repo",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "script_save",
      "description": "Save a deterministic action you repeat (a curl or gh fetch, a report, a lookup) as a script, so later sessions run it with script_run instead of working it out again. A script with the same name in the scope is replaced. Scripts run with the user's environment: read secrets from environment variables (for example $GH_TOKEN), never write them into the body (a body holding a credential is refused). Arguments arrive as $1, $2 (sys.argv, process.argv), never through a shell. What you save runs here without approval, since you wrote it: never save the code of a script that waits for approval, edited or not, to run it (an unedited copy waits for approval too). When scripts are set to remote+local, new scripts are saved on this computer, next to the team's.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global"
            ],
            "default": "repo",
            "description": "repo: this repository; global: shared by all repositories"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "maxLength": 64,
            "description": "Short name, unique in the scope, for example open-prs"
          },
          "description": {
            "type": "string",
            "description": "What the script does and its arguments (at most 500 characters)"
          },
          "language": {
            "type": "string",
            "enum": [
              "sh",
              "bash",
              "python",
              "node",
              "bun"
            ],
            "description": "The interpreter (python: python3, else python)"
          },
          "body": {
            "type": "string",
            "description": "The script source (at most 65536 bytes)"
          },
          "timeout_secs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600,
            "default": 60,
            "description": "Seconds a run may take before it is killed"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [
          "name",
          "description",
          "language",
          "body",
          "project_path"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "script_list",
      "description": "List saved scripts, repository scripts first: check here before working out a repeated action again. Without a query every visible script is listed. `place` says where a script is kept (team or local); `readOnly` marks a team script that cannot be changed from here (scripts set to remote+local).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "all"
            ],
            "default": "all",
            "description": "repo: this repository; global: shared by all repositories; all: both"
          },
          "query": {
            "type": "string",
            "description": "Keeps scripts whose name or description contains it (at most 256 characters)"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "script_get",
      "description": "Read a script with its body, by id or name (a name is looked up in this repository first, then in the global scope, a script saved on this computer before a team one with the same name). `approval` says why this machine runs it (local: saved here, approved: approved by the user here, team: every team script is trusted) or that the user must approve it first (needed).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Script id (give id or name)"
          },
          "name": {
            "type": "string",
            "description": "Script name (give id or name)"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "all"
            ],
            "default": "all",
            "description": "repo: this repository; global: shared by all repositories; all: both"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "script_run",
      "description": "Run a saved script by id or name and get its exit code, stdout and stderr (capped, secrets masked). Prefer it over repeating the steps by hand. A script saved on another machine, or changed, renamed or moved since this machine approved it, runs only after the user approves it: when Harness Desktop runs, the call waits up to 45 s for the user's answer there (when your client stops waiting sooner, call script_run again once the user approved). You cannot approve a script: when the run is refused, ask the user to approve it in Harness Desktop → Memory (the user can also run `harness-memory trust` in a terminal), then call script_run again.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Script id (give id or name)"
          },
          "name": {
            "type": "string",
            "description": "Script name (give id or name)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "maxItems": 32,
            "description": "Arguments, passed as they are (no shell)"
          },
          "stdin": {
            "type": "string",
            "description": "Standard input (at most 65536 bytes)"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "all"
            ],
            "default": "all",
            "description": "repo: this repository; global: shared by all repositories; all: both"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "script_delete",
      "description": "Delete a stale or wrong script by id or name. A team script is read-only when scripts are set to remote+local (refused): save a script of your own instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Script id (give id or name)"
          },
          "name": {
            "type": "string",
            "description": "Script name (give id or name)"
          },
          "scope": {
            "type": "string",
            "enum": [
              "repo",
              "global",
              "all"
            ],
            "default": "all",
            "description": "repo: this repository; global: shared by all repositories; all: both"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path of the repository you are working in (your working directory's git root). Always pass it: the server's own working directory may be another project. Unused for scope global"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    }
  ]
}
